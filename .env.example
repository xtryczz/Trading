# ============================================================
# Nastavení copy-trading bota. Zkopíruj tento soubor jako ".env"
# a doplň své hodnoty. Soubor ".env" NIKDY nikomu neposílej
# a nenahrávej na internet (je v .gitignore).
# ============================================================

# --- Režim -------------------------------------------------
# paper = jen simulace, bot NIC neposílá (výchozí, bezpečné)
# live  = skutečné obchody (až fáze 4, zapínej jen ručně!)
MODE=paper

# --- Připojení k Solaně (Helius) ----------------------------
# Stačí vložit API klíč z helius.dev. Adresy se z něj složí samy.
HELIUS_API_KEY=
# Volitelně si můžeš nastavit vlastní adresy (přebijí klíč výše):
# RPC_URL=https://mainnet.helius-rpc.com/?api-key=TVUJ_KLIC
# WS_URL=wss://mainnet.helius-rpc.com/?api-key=TVUJ_KLIC

# --- Tradeři ke sledování -----------------------------------
# Seznam oddělený čárkou. Formát: jmeno:adresa  (jméno je jen pro přehlednost)
# Příklad: TRADERS=Honza:7xKX...abc,Petr:9aBc...xyz
TRADERS=

# --- Nákup --------------------------------------------------
# Kolik SOL utratíme za jeden zkopírovaný nákup
BUY_AMOUNT_SOL=0.05
# Ignoruj nákupy tradera menší než X SOL
MIN_TRADER_BUY_SOL=0.5
# Maximální počet současně otevřených pozic
MAX_OPEN_POSITIONS=5
# Součet SOL ve všech otevřených pozicích nesmí přesáhnout tento limit
MAX_TOTAL_SOL_AT_RISK=0.3
# Nekupuj, když je naše cena o víc než X % horší než cena tradera (jsme pozdě)
MAX_PRICE_DRIFT_PCT=25

# --- Jupiter (nacenění a swapy) -----------------------------
# Povolené prokluzy v bázických bodech (100 = 1 %)
SLIPPAGE_BPS=300
# Priority fee v lamportech (použije se až v live módu, fáze 4)
PRIORITY_FEE_LAMPORTS=100000
JUPITER_URL=https://lite-api.jup.ag
# Volitelně API klíč Jupiteru (pokud ho máš)
# JUPITER_API_KEY=

# --- Výstupy z pozic ----------------------------------------
# true = když trader prodá X % pozice, prodáme X % naší
MIRROR_SELLS=true
# Zisk v %, při kterém prodáme vše (100 = zdvojnásobení)
TAKE_PROFIT_PCT=100
# Ztráta v %, při které prodáme vše
STOP_LOSS_PCT=40
# Jak často (sekundy) kontrolovat ceny otevřených pozic
PRICE_CHECK_INTERVAL_SEC=30

# --- Soubory ------------------------------------------------
POSITIONS_FILE=positions.json
TRADES_FILE=trades.jsonl

# --- Privátní klíč (POUZE fáze 4, live mód) -----------------
# Použij NOVOU peněženku jen pro bota s malou částkou!
# V paper módu nech prázdné.
PRIVATE_KEY=
